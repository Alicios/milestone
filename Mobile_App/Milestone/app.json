{
  "name": "Milestone",
  "displayName": "Milestone",
  "userInterfaceStyle": "automatic",
  "web": {
    "bundler": "metro"
  },
  "android": {
    "package": "com.anonymous.milestone"
  },
  "ios": {
    "bundleIdentifier": "com.anonymous.milestone",
    "infoPlist": {
      "NSMotionUsageDescription": "Allow Milestone to use phone movement to tilt the hidden image."
    }
  },
  "plugins": [
    "expo-font",
    [
      "expo-audio",
      {
        "microphonePermission": false,
        "recordAudioAndroid": false,
        "enableBackgroundPlayback": false
      }
    ],
    "expo-asset",
    [
      "expo-sensors",
      {
        "motionPermission": "Allow Milestone to use phone movement to tilt the hidden image."
      }
    ],
    "expo-secure-store",
    "expo-localization",
    [
      "expo-image-picker",
      {
        "photosPermission": "Allow Milestone to choose your profile photo.",
        "cameraPermission": false,
        "microphonePermission": false
      }
    ]
  ]
}
