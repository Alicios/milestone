# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API

# Used by the app (Vite exposes anything prefixed VITE_ to the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional for the API: without this, onboarding is forwarded to the project's
# authenticated patient-onboarding Edge Function using its built-in credentials.
# Required by local admin scripts in scripts/.
# Used by api/invite-patient.ts when present
# (never exposed to the browser because it has no VITE_ prefix). Get it from
# Project Settings -> API -> service_role secret. Never commit this value or
# share it. In production, set this in Vercel's Project Settings -> Environment
# Variables too — .env.local only configures local dev, not your deployment.
#
# api/invite-patient.ts uses this to generate patients a one-time passcode
# (supabase.auth.admin.generateLink) — the code is stored
# on the patient's row for the provider's web app to display and relay to
# them directly. They enter it in Mobile_App to sign in, no password or web
# landing page involved.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Server-only email delivery. Use a sender on your verified Resend domain.
# Set these in Vercel too. Missing/failed delivery leaves the generated code
# available to relay directly and displays a warning instead of claiming mail sent.
RESEND_API_KEY=your-resend-api-key
PATIENT_EMAIL_FROM=Milestone <login@your-verified-domain.example>
