# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API

# Used by the app (Vite exposes anything prefixed VITE_ to the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used by the local admin scripts in scripts/ AND by api/invite-patient.ts
# (never exposed to the browser because it has no VITE_ prefix). Get it from
# Project Settings -> API -> service_role secret. Never commit this value or
# share it. In production, set this in Vercel's Project Settings -> Environment
# Variables too — .env.local only configures local dev, not your deployment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Used by api/invite-patient.ts. Where a patient's invitation email link sends
# them to finish choosing a password. Point this at wherever patient-setup.html
# is deployed, e.g. https://your-web-app.vercel.app/patient-setup.html, and add
# that exact URL to Supabase Auth -> URL Configuration -> Redirect URLs, or
# Supabase will reject the redirect. Also needs to be set in Vercel's
# Environment Variables for production, not just here.
PATIENT_INVITE_REDIRECT_URL=
