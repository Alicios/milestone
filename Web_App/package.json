{
  "name": "provider-web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "test:auth": "node --test tests/authentication*.test.mjs",
    "test:routines": "node --test tests/catalogRoutines.test.mjs",
    "test:scheduling": "node --test tests/scheduling.test.mjs",
    "test:scheduling:db": "python3 supabase/tests/scheduling_integration.py",
    "test:scheduling:browser": "playwright test",
    "test:patients": "node --test tests/patientCreation.test.mjs",
    "test:approve-access-request": "node --test tests/approveAccessRequest.test.mjs",
    "requests:list": "node scripts/list-access-requests.mjs",
    "requests:approve": "node scripts/approve-access-request.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.2.6",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.3"
  }
}
